@model HelpDeskMvc.Models.ListarChamadosViewModel

@{
    ViewData["Title"] = "Chamados";
}

<div class="container mt-4">
    <h1>Chamados</h1>
    <hr />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="text"
                   name="busca"
                   value="@Model.Busca"
                   class="form-control"
                   style="max-width: 260px;"
                   placeholder="Buscar por título ou descrição" />

            <select name="status" class="form-select" style="max-width: 200px;">
                <option value="">Todos os status</option>
                <option value="Aberto" selected="@(Model.Status == "Aberto")">Aberto</option>
                <option value="EmAndamento" selected="@(Model.Status == "Em atendimento" || Model.Status == "EmAndamento")">Em andamento</option>
                <option value="Fechado" selected="@(Model.Status == "Fechado")">Fechado</option>
                <option value="Resolvido" selected="@(Model.Status == "Resolvido")">Resolvido</option>
                <option value="Cancelado" selected="@(Model.Status == "Cancelado")">Cancelado</option>
            </select>

            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="Chamados" asp-action="Index" class="btn btn-outline-secondary">Limpar filtros</a>
        </form>

        <a asp-controller="Chamados" asp-action="Criar" class="btn btn-success">
            Criar Garantia
        </a>
    </div>

    @if (Model.Chamados.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum chamado encontrado para os filtros informados.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Cliente</th>
                    <th>Telefone</th>
                    <th>Status</th>
                    <th>Data Abertura</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var chamado in Model.Chamados)
                {
                    <tr>
                        <td>@chamado.Titulo</td>
                        <td>@(string.IsNullOrEmpty(chamado.ClienteNome) ? "-" : chamado.ClienteNome)</td>
                        <td>@(string.IsNullOrEmpty(chamado.Telefone) ? "-" : chamado.Telefone)</td>
                        <td>@chamado.Status</td>
                        <td>@chamado.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Chamados"
                               asp-action="Detalhes"
                               asp-route-id="@chamado.Id"
                               class="btn btn-primary btn-sm">
                                Ver Detalhes
                            </a>
                            <a asp-controller="Chamados"
                               asp-action="Editar"
                               asp-route-id="@chamado.Id"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>
                            <form asp-controller="Chamados"
                                  asp-action="Excluir"
                                  asp-route-id="@chamado.Id"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Deseja excluir esta solicitação?');">
                                    Excluir
                                </button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>