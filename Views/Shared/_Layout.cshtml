<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{ var user = Context.Session.GetString("Usuario"); var permissoesNav = Context.Session.GetString("PermissoesNav"); var permissoes = string.IsNullOrWhiteSpace(permissoesNav) ? new[] { "Home" } : permissoesNav.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); }
        @if (!string.IsNullOrEmpty(user))
        {
            <nav class="navbar navbar-expand-lg app-navbar">
                <div class="container container-app">
                    <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/compretec-logo.svg" alt="Logo CompreTec" class="nav-logo" />
                    </a>
                    <button class="navbar-toggler app-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-lg-flex justify-content-between align-items-center">
                        <ul class="navbar-nav app-nav">
                            @if (user == "admin" || permissoes.Contains("Home", StringComparer.OrdinalIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                            }
                            @if (user == "admin" || permissoes.Contains("Chamados", StringComparer.OrdinalIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Chamados" asp-action="Index">Chamados</a>
                                </li>
                            }
                            @if (user == "admin" || permissoes.Contains("Estoque", StringComparer.OrdinalIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Estoque" asp-action="Index">Estoque</a>
                                </li>
                            }
                            @if (user == "admin" || permissoes.Contains("Configuracoes", StringComparer.OrdinalIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Configuracoes">Configurações</a>
                                </li>
                            }
                        </ul>

                        <div class="user-panel">
                            <div class="dropdown">
                                <button class="btn user-button dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    Olá, @user
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <form asp-area="" asp-controller="Home" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Desconectar</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        }
    </header>

    <div class="container container-app">
        <main role="main" class="page-shell">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container container-app footer-content">
            <div class="footer-brand-block">
                <span class="footer-brand">&copy; 2026 CompreTec</span>
                <p>Plataforma para controle de chamados, gestão de estoque e organização operacional.</p>
            </div>

            <div class="footer-columns">
                <div class="footer-column">
                    <h5>Navegação</h5>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Chamados" asp-action="Index">Chamados</a>
                    <a asp-area="" asp-controller="Estoque" asp-action="Index">Estoque</a>
                </div>

                <div class="footer-column">
                    <h5>Suporte</h5>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
                    <span>Atendimento ao usuário</span>
                    <span>Central de dúvidas</span>
                </div>

                <div class="footer-column">
                    <h5>Contato</h5>
                    <span>compretec@suporte.com</span>
                    <span>(11) 4000-2026</span>
                    <span>São Paulo - SP</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
