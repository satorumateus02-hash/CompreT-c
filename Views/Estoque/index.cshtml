@model List<HelpDeskMvc.Models.Produto>

@{
    ViewData["Title"] = "Estoque";
}

<div class="container mt-4">
    <h1>Estoque</h1>
    <hr />

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Busca</label>
                    <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Nome, categoria, fornecedor..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Categoria</label>
                    <input type="text" name="categoria" value="@ViewData["Categoria"]" class="form-control" placeholder="Categoria" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Fornecedor</label>
                    <input type="text" name="fornecedor" value="@ViewData["Fornecedor"]" class="form-control" placeholder="Fornecedor" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Preço mín.</label>
                    <input type="number" step="0.01" name="precoMin" value="@ViewData["PrecoMin"]" class="form-control" placeholder="0,00" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Preço máx.</label>
                    <input type="number" step="0.01" name="precoMax" value="@ViewData["PrecoMax"]" class="form-control" placeholder="999,99" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Qtd. mín.</label>
                    <input type="number" name="quantidadeMin" value="@ViewData["QuantidadeMin"]" class="form-control" placeholder="0" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ordenar</label>
                    <select name="ordenar" class="form-select">
                        <option value="nome" selected="@(((string?)ViewData["Ordenar"]) == "nome")">Nome</option>
                        <option value="preco" selected="@(((string?)ViewData["Ordenar"]) == "preco")">Preço</option>
                        <option value="data" selected="@(((string?)ViewData["Ordenar"]) == "data")">Data cadastro</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" name="estoqueBaixo" value="true" checked="@((bool?)ViewData["EstoqueBaixo"] == true)" />
                        <label class="form-check-label">Estoque baixo</label>
                    </div>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Buscar</button>
                    <a asp-controller="Estoque" asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-3 d-flex justify-content-end">
        <a asp-controller="Estoque" asp-action="Criar" class="btn btn-success">Novo Produto</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Nenhum produto encontrado para os filtros informados.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Preço</th>
                    <th>Quantidade</th>
                    <th>Fornecedor</th>
                    <th>Categoria</th>
                    <th>Data Cadastro</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>@produto.Nome</td>
                        <td>@produto.Descricao</td>
                        <td>@produto.Preco.ToString("C")</td>
                        <td>
                            @if (produto.Quantidade <= 5)
                            {
                                <span class="badge bg-danger">@produto.Quantidade - Baixo</span>
                            }
                            else
                            {
                                @produto.Quantidade
                            }
                        </td>
                        <td>@produto.Fornecedor</td>
                        <td>@produto.Categoria</td>
                        <td>@produto.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-controller="Estoque" asp-action="Detalhes" asp-route-id="@produto.Id" class="btn btn-primary btn-sm">Ver</a>
                                <a asp-controller="Estoque" asp-action="Editar" asp-route-id="@produto.Id" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-controller="Estoque" asp-action="Excluir" asp-route-id="@produto.Id" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@produto.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Confirma exclusão deste produto?');">Excluir</button>
                                    @Html.AntiForgeryToken()
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
