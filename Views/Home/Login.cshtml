
@using HelpDeskMvc.Controllers
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">Login</h2>
                <form asp-action="Login" asp-controller="Home" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input name="Usuario" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input name="Senha" type="password" class="form-control" />
                    </div>

                    @if(TempData["LoginErrors"] != null) {
                        <div class="text-danger mb-3">@TempData["LoginErrors"]</div>
                    }

                    <div class="d-flex flex-column align-items-stretch mt-3">
                        <button type="submit" class="btn btn-primary">Entrar</button>
                        <a asp-action="Register" asp-controller="Home" class="text-decoration-none mt-2 text-center">Adicionar Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
